CH_CORE_DATABASE_URL=mariadb://CH_CORE_USER:CH_CORE_PASSWORD@127.0.0.1:3306/CH_CORE_DATABASE
CH_CORE_PRIVATE_STORAGE_HOST_PATH=/volume1/CH_CORE_PRIVATE_STORAGE_PATH
# These are enforced again by compose.yaml.
CH_CORE_HOST=127.0.0.1
CH_CORE_PORT=18080
CH_CORE_DB_POOL_MAX=4
# Optional; owner bootstrap stays disabled unless this is at least 32 bytes.
CH_CORE_OWNER_BOOTSTRAP_SECRET=
