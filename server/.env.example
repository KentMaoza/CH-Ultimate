CH_CORE_DATABASE_URL=mariadb://CH_CORE_USER:CH_CORE_PASSWORD@localhost/CH_CORE_DATABASE
# The NAS compose file forces /run/mysqld/mysqld10.sock and does not enable
# MariaDB TCP. Leave this unset for ordinary TCP-based local development.
CH_CORE_DATABASE_SOCKET=
CH_CORE_PRIVATE_STORAGE_HOST_PATH=/volume1/CH_CORE_PRIVATE_STORAGE_PATH
CH_CORE_BACKUP_HOST_PATH=/volumeUSBX/CH_CORE_BACKUP_PATH
CH_CORE_RUNTIME_UID=REPLACE_WITH_NONZERO_NUMERIC_UID
CH_CORE_RUNTIME_GID=REPLACE_WITH_NONZERO_NUMERIC_GID
# Use a read-only account for /chu and a different scratch-only account whose
# URL path is exactly /chu_restore_NAME. These values may remain blank until
# the opt-in ch-core-ops profile is run. Keep hostname localhost with no port;
# the ops client is forced through the read-only MariaDB Unix socket.
CH_CORE_BACKUP_DATABASE_URL=
CH_CORE_RESTORE_DATABASE_URL=
CH_CORE_MARIADB_SOCKET=/run/mysqld/mysqld10.sock
# These are enforced again by compose.yaml.
CH_CORE_HOST=127.0.0.1
CH_CORE_PORT=18080
CH_CORE_DB_POOL_MAX=4
# Optional; owner bootstrap stays disabled unless this is at least 32 bytes.
CH_CORE_OWNER_BOOTSTRAP_SECRET=
