{
  "name": "@ch-ultimate/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "CH_CORE_INTEGRATION=1 vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
